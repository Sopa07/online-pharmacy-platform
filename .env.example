# Frontend API base.
# On Netlify, leave this blank and use same-origin /api routes.
VITE_API_BASE_URL=/api

# Backend settings.
# Comma-separated list for production, deploy previews, and local development.
API_ALLOWED_ORIGIN=http://localhost:5173

# Supabase project used for auth and persistence (required).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Optional comma-separated allowlist of admin emails.
# Users whose Supabase app_metadata.role is "admin" are also admins.
ADMIN_EMAILS=admin@example.com
